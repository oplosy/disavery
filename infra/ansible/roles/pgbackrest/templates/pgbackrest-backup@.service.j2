[Unit]
Description=pgBackRest %i backup to every repository
After=postgresql@{{ pg_version }}-main.service

[Service]
Type=oneshot
User=postgres
# pgBackRest fails at once (error 50) instead of waiting when another backup
# of the stanza holds its lock, e.g. the hourly incr timer firing while a full
# backup is started by hand or by `disavery seed`. flock queues them instead.
ExecStart=/usr/bin/flock /run/lock/pgbackrest-backup.lock /usr/bin/pgbackrest --stanza={{ pgbackrest_stanza }} --repo=1 --type=%i backup
ExecStart=/usr/bin/flock /run/lock/pgbackrest-backup.lock /usr/bin/pgbackrest --stanza={{ pgbackrest_stanza }} --repo=2 --type=%i backup
